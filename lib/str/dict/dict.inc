; =============================================================================
; str/dict/dict.inc
; Type and constant definitions for the str library's dict module — the
; default English dictionary: exact lookup, prefix/autocomplete, and
; edit-distance spellcheck suggestions.
;
; Part of Utkarsha Labs / Tattva OS — str library
; Arch: x86_64 | Assembler: NASM
;
; The dictionary itself is not built at runtime. dict/tables/dict_table.asm
; (generated by tools/gen_dict_table.py from a SCOWL-derived wordlist) is a
; static, byte-sorted table baked into the kernel image:
;
;   dict_word_count            u32          — N, total word count
;   dict_blob_size              u32          — total blob byte length
;   dict_offsets[0..N)         u32[]         — byte offset of word i in blob
;   dict_lengths[0..N)         u8[]          — byte length of word i
;   dict_blob                  u8[]          — concatenated word bytes
;
; Sort order is the raw UTF-8 byte sequence of each word, which is the same
; total order as codepoint order — so a plain byte-wise binary search is a
; correct, locale-independent lookup. There is no init step and nothing to
; allocate: the table is ready as soon as the kernel image is mapped.
; =============================================================================

%ifndef GUARD_LIB_STR_DICT_DICT_INC
%define GUARD_LIB_STR_DICT_DICT_INC

%include "lib/str/arch/common/types.inc"
%include "lib/str/arch/common/error.inc"
%include "lib/str/arch/common/macros.inc"

; -----------------------------------------------------------------------------
; DictMatch — one result from lookup/prefix/suggest.
;
;   ptr       dq  — pointer into dict_blob (borrowed; never free/mutate)
;   len       dq  — word byte length
;   distance  dq  — edit distance for suggest() results; 0 for exact/prefix
;
; Layout: 24 bytes, 8-byte aligned
; -----------------------------------------------------------------------------

struc DictMatch
    .ptr        resq 1
    .len        resq 1
    .distance   resq 1
endstruc

DICTMATCH_SIZE  equ 24

; A word longer than this was rejected at table-generation time (see
; MAX_WORD_LEN in tools/gen_dict_table.py) — dict_lengths[] is a byte.
DICT_MAX_WORD_LEN          equ 255

; suggest() runs a full Levenshtein DP over the query and each candidate.
; Rows are stack buffers sized for this bound, so query and candidate words
; longer than this are rejected with STR_ERR_INVALID_ARG rather than silently
; truncated. Every English wordlist entry seen in practice is far shorter.
DICT_SUGGEST_MAX_LEN       equ 128

; Hard ceiling on the caller-supplied max_distance for suggest(). Kept small
; because suggestions past this distance are not useful "did you mean"
; candidates, and because it bounds the DP row width.
DICT_SUGGEST_MAX_DISTANCE  equ 8

%endif ; GUARD_LIB_STR_DICT_DICT_INC
