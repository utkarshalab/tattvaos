protocol canvas-input 1 {

    ; ========================================================================
    ; Input events, sent by src/input/input.asm. A client gets them only for
    ; its own surfaces, and only while that surface has the pointer or the
    ; keyboard. Every event starts (time, surface): time is the monotonic
    ; nanosecond the input happened, surface the client's handle.
    ;
    ; No requests yet: a client receives these without asking.
    ; ========================================================================

    ; ------------------------------------------------------------------------
    ; cw_pointer — the pointer over a surface, in surface coordinates
    ; ------------------------------------------------------------------------
    interface cw_pointer 1 {
        enum button {
            left = 0,
            right = 1,
            middle = 2          ; others up to 31
        }

        enum axis {
            vertical = 0,       ; positive scrolls down
            horizontal = 1      ; positive scrolls right
        }

        event enter(time: ulong, surface: handle, x: int, y: int)
        event leave(time: ulong, surface: handle)
        event motion(time: ulong, surface: handle, x: int, y: int)

        ; state 1 pressed, 0 released. A surface that gets a press keeps the
        ; pointer, and its motion, until every button is up.
        event button(time: ulong, surface: handle, button: uint, state: uint)

        ; value: signed steps
        event axis(time: ulong, surface: handle, axis: uint, value: int)

        enum shape {
            default = 0,        ; the arrow
            text = 1,           ; an I-beam, for places to type
            crosshair = 2
        }

        ; The pointer's shape while it is over this surface of the client's
        request set_shape(surface: handle, shape: uint)
    }

    ; ------------------------------------------------------------------------
    ; cw_touch — fingers on a touch screen (TCH-01)
    ; ------------------------------------------------------------------------
    ; Each contact (slot) belongs to the surface it went down on until it is
    ; up or cancelled. xy is the place in the surface's own pixels, x in the
    ; low 16 bits and y in the high 16, each signed. After each scan, every
    ; surface that heard of a contact in it gets frame.
    interface cw_touch 1 {
        event down(time: ulong, surface: handle, slot: uint, xy: uint)
        event motion(time: ulong, surface: handle, slot: uint, xy: uint)
        event up(time: ulong, surface: handle, slot: uint, unused: uint)
        event cancel(time: ulong, surface: handle, slot: uint, unused: uint)
        event frame(time: ulong, surface: handle)
    }

    ; ------------------------------------------------------------------------
    ; cw_tablet_tool — a pen (TCH-10)
    ; ------------------------------------------------------------------------
    ; The pen is with the surface under it, and while its tip is down with
    ; the one it touched. Positions are in the surface's own pixels.
    interface cw_tablet_tool 1 {
        ; tool: 0 pen, 1 eraser end, 2 brush, 3 airbrush
        event proximity_in(time: ulong, surface: handle, tool: uint, unused: uint)
        event proximity_out(time: ulong, surface: handle)
        event motion(time: ulong, surface: handle, x: int, y: int)
        ; pressure in the low 16 bits and hover distance in the high, each
        ; 0-65535; tilt x, tilt y (signed degrees) and rotation (0-359) as
        ; bits 0-7, 8-15 and 16-24
        event axes(time: ulong, surface: handle, pressure_distance: uint, tilt_rotation: uint)
        event tip(time: ulong, surface: handle, down: uint, unused: uint)
        ; button: 0 the first barrel button, 1 the second
        event button(time: ulong, surface: handle, button: uint, state: uint)
    }

    ; ------------------------------------------------------------------------
    ; cw_gesture — touchpad hold, swipe and pinch (TCH-02)
    ; ------------------------------------------------------------------------
    ; To the surface under the pointer when the fingers went down, behind
    ; CAP_POINTER. A hold begins as fingers go down; it ends, cancelled, when
    ; they become a swipe (three or more moving together) or a pinch (two
    ; spreading or closing). A gesture ends when the fingers change, not
    ; cancelled only when all are lifted. dxy: the fingers' middle moved,
    ; x in the low 16 bits and y in the high, each signed, in pixels; scale:
    ; 16.16, since the pinch began. Four or more fingers moving together are
    ; the server's (they switch workspaces): no swipe for them.
    interface cw_gesture 1 {
        event hold_begin(time: ulong, surface: handle, fingers: uint, unused: uint)
        event hold_end(time: ulong, surface: handle, cancelled: uint, unused: uint)
        event swipe_begin(time: ulong, surface: handle, fingers: uint, unused: uint)
        event swipe_update(time: ulong, surface: handle, dxy: uint, fingers: uint)
        event swipe_end(time: ulong, surface: handle, cancelled: uint, unused: uint)
        event pinch_begin(time: ulong, surface: handle, fingers: uint, unused: uint)
        event pinch_update(time: ulong, surface: handle, scale: uint, dxy: uint)
        event pinch_end(time: ulong, surface: handle, cancelled: uint, unused: uint)
    }

    ; ------------------------------------------------------------------------
    ; cw_tablet_pad — a pen tablet's buttons, rings and strips (TCH-10)
    ; ------------------------------------------------------------------------
    ; They go to the surface with the keyboard. ring: the angle 0-359, or
    ; 0xFFFFFFFF when the finger leaves it; strip: the place 0-65535, or
    ; 0xFFFFFFFF likewise.
    interface cw_tablet_pad 1 {
        event button(time: ulong, surface: handle, button: uint, state: uint)
        event ring(time: ulong, surface: handle, ring: uint, angle: uint)
        event strip(time: ulong, surface: handle, strip: uint, position: uint)
    }

    ; ------------------------------------------------------------------------
    ; cw_seat — the seat's switches and input devices (SES-08)
    ; ------------------------------------------------------------------------
    ; watch answers with switched(which, 1) for each switch that is on, then
    ; done; from then on the client hears each switch that changes and each
    ; input device added, removed or changed. Needs CAP_SEAT.
    ;
    ; which: 0 lid, 1 tablet mode, 2 dock, 3 headphone jack, 4 camera
    ; shutter, 5 microphone mute, 6 keypad slide; state 1 on or closed.
    ; change: 0 added, 1 removed, 2 changed; caps: 1 keyboard, 2 pointer,
    ; 4 touch, 8 pen tablet, 16 switches. Closing the lid turns the built-in
    ; panel off, and locks the session unless another screen is on.
    interface cw_seat 1 {
        request watch()

        event switched(which: uint, state: uint)
        event device(change: uint, id: uint, caps: uint)
        event done()
    }

    ; ------------------------------------------------------------------------
    ; cw_dnd — drag and drop
    ; ------------------------------------------------------------------------
    ; A drag offers its data as cw_clipboard selection 2. It starts while a
    ; button is held on one of the client's surfaces; the surface under the
    ; pointer hears enter (with what is offered, as cw_clipboard.offered),
    ; motion and leave; letting go over one drops there, and its client may
    ; then paste selection 2. Positions are in the surface's own pixels.
    ;
    ; Actions: copy 1, move 2. The one dragging offers some (copy if it says
    ; nothing); the one under the pointer hears them in enter and accepts
    ; one; a drop happens only where one was accepted.
    interface cw_dnd 1 {
        request start(surface: handle, count: uint, types: array<string>)

        ; The one dragging: the actions it allows
        request set_actions(actions: uint)

        ; The one dragging: one of its surfaces drawn at the pointer, off the
        ; screen otherwise, while the drag lasts
        request set_icon(surface: handle)

        ; The one under the pointer: the action it would take, 0 none
        request accept(action: uint)

        event enter(surface: handle, x: int, y: int, actions: uint)
        event motion(surface: handle, x: int, y: int)
        event leave(surface: handle)
        event drop(surface: handle, x: int, y: int, action: uint)

        ; To the one dragging: dropped 1 on a surface, 0 not; the action
        ; taken (a move: the data goes from it)
        event finished(dropped: uint, action: uint)
    }

    ; ------------------------------------------------------------------------
    ; cw_keyboard — keys for the surface with keyboard focus
    ; ------------------------------------------------------------------------
    interface cw_keyboard 1 {
        ; A press on a surface gives it the focus
        event enter(time: ulong, surface: handle)

        ; Treat every key as released
        event leave(time: ulong, surface: handle)

        ; keycode 0-255 as the device reports it; state 1 pressed, 0
        ; released, 2 repeated: the key is still held, after a delay and then
        ; at a steady rate, each repeat followed by its text like a press.
        ; Modifiers and locks do not repeat.
        event key(time: ulong, surface: handle, keycode: uint, state: uint)

        enum key_state {
            released = 0,
            pressed = 1,
            repeated = 2
        }

        enum modifier {
            shift = 1,
            caps_lock = 2,
            ctrl = 4,
            alt = 8,
            super = 16,
            num_lock = 32
        }

        ; After enter, and after any key that changes them: held is shift,
        ; ctrl, alt and super; locked is caps_lock and num_lock
        event modifiers(time: ulong, surface: handle, held: uint, locked: uint)

        ; After the key event of a press that types a character (US layout
        ; for now); none while ctrl, alt or super is held. modifiers: held
        ; and locked together.
        event text(time: ulong, surface: handle, codepoint: uint, modifiers: uint)
    }
}
