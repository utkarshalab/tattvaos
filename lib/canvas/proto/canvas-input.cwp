protocol canvas-input 1 {

    ; ========================================================================
    ; Input events, sent by src/input/input.asm. A client gets them only for
    ; its own surfaces, and only while that surface has the pointer or the
    ; keyboard. Every event starts (time, surface): time is the monotonic
    ; nanosecond the input happened, surface the client's handle.
    ;
    ; No requests yet: a client receives these without asking.
    ; ========================================================================

    ; ------------------------------------------------------------------------
    ; cw_pointer — the pointer over a surface, in surface coordinates
    ; ------------------------------------------------------------------------
    interface cw_pointer 1 {
        enum button {
            left = 0,
            right = 1,
            middle = 2          ; others up to 31
        }

        enum axis {
            vertical = 0,       ; positive scrolls down
            horizontal = 1      ; positive scrolls right
        }

        event enter(time: ulong, surface: handle, x: int, y: int)
        event leave(time: ulong, surface: handle)
        event motion(time: ulong, surface: handle, x: int, y: int)

        ; state 1 pressed, 0 released. A surface that gets a press keeps the
        ; pointer, and its motion, until every button is up.
        event button(time: ulong, surface: handle, button: uint, state: uint)

        ; value: signed steps
        event axis(time: ulong, surface: handle, axis: uint, value: int)

        enum shape {
            default = 0,        ; the arrow
            text = 1,           ; an I-beam, for places to type
            crosshair = 2
        }

        ; The pointer's shape while it is over this surface of the client's
        request set_shape(surface: handle, shape: uint)
    }

    ; ------------------------------------------------------------------------
    ; cw_dnd — drag and drop
    ; ------------------------------------------------------------------------
    ; A drag offers its data as cw_clipboard selection 2. It starts while a
    ; button is held on one of the client's surfaces; the surface under the
    ; pointer hears enter (with what is offered, as cw_clipboard.offered),
    ; motion and leave; letting go over one drops there, and its client may
    ; then paste selection 2. Positions are in the surface's own pixels.
    ;
    ; Actions: copy 1, move 2. The one dragging offers some (copy if it says
    ; nothing); the one under the pointer hears them in enter and accepts
    ; one; a drop happens only where one was accepted.
    interface cw_dnd 1 {
        request start(surface: handle, count: uint, types: array<string>)

        ; The one dragging: the actions it allows
        request set_actions(actions: uint)

        ; The one dragging: one of its surfaces drawn at the pointer, off the
        ; screen otherwise, while the drag lasts
        request set_icon(surface: handle)

        ; The one under the pointer: the action it would take, 0 none
        request accept(action: uint)

        event enter(surface: handle, x: int, y: int, actions: uint)
        event motion(surface: handle, x: int, y: int)
        event leave(surface: handle)
        event drop(surface: handle, x: int, y: int, action: uint)

        ; To the one dragging: dropped 1 on a surface, 0 not; the action
        ; taken (a move: the data goes from it)
        event finished(dropped: uint, action: uint)
    }

    ; ------------------------------------------------------------------------
    ; cw_keyboard — keys for the surface with keyboard focus
    ; ------------------------------------------------------------------------
    interface cw_keyboard 1 {
        ; A press on a surface gives it the focus
        event enter(time: ulong, surface: handle)

        ; Treat every key as released
        event leave(time: ulong, surface: handle)

        ; keycode 0-255 as the device reports it; state 1 pressed, 0
        ; released, 2 repeated: the key is still held, after a delay and then
        ; at a steady rate, each repeat followed by its text like a press.
        ; Modifiers and locks do not repeat.
        event key(time: ulong, surface: handle, keycode: uint, state: uint)

        enum key_state {
            released = 0,
            pressed = 1,
            repeated = 2
        }

        enum modifier {
            shift = 1,
            caps_lock = 2,
            ctrl = 4,
            alt = 8,
            super = 16,
            num_lock = 32
        }

        ; After enter, and after any key that changes them: held is shift,
        ; ctrl, alt and super; locked is caps_lock and num_lock
        event modifiers(time: ulong, surface: handle, held: uint, locked: uint)

        ; After the key event of a press that types a character (US layout
        ; for now); none while ctrl, alt or super is held. modifiers: held
        ; and locked together.
        event text(time: ulong, surface: handle, codepoint: uint, modifiers: uint)
    }
}
